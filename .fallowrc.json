{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	// src/**/*.mdx mirrors the Storybook stories glob in .storybook/main.ts;
	// fallow's storybook plugin only detects *.stories.* files, not docs pages.
	// scripts/*.ts are run directly by justfile recipes, such as og-image.
	"entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}", "src/**/*.mdx", "scripts/*.ts"],
	"ignorePatterns": [".storybook/**"],
	"ignoreDependencies": ["eslint-plugin-storybook"],
	"duplicates":
	{
		"minOccurrences": 3
	},
	"rules":
	{
		"unused-dependencies": "warn"
	}
}
