{
	"name": "animal-kingdom",
	"version": "0.0.0",
	"description": "Animal Kingdom battle game",
	"type": "module",
	"scripts":
	{
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"preview": "vp preview",
		"build": "tsgo && vp build",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "oxfmt-next-line",
		"fmt:ci": "oxfmt-next-line --check",
		"fallow": "fallow fix --yes",
		"fallow:ci": "fallow dead-code",
		"typecheck": "tsgo --noEmit",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"test:run": "node node_modules/vitest/dist/cli.js run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && test-storybook\"",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"dependencies":
	{
		"lucide-react": "^1.70.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies":
	{
		"@chromatic-com/storybook": "^5.6.0",
		"@storybook/addon-a11y": "^10.6.6",
		"@storybook/addon-docs": "^10.6.6",
		"@storybook/addon-vitest": "^10.6.6",
		"@storybook/react-vite": "^10.6.6",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native-preview": "^7.0.0-dev.20260702.3",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "^10.14.0",
		"eslint-plugin-storybook": "^10.6.6",
		"fallow": "^3.41.0",
		"jsdom": "^31.0.0",
		"markdownlint-cli2": "^0.24.0",
		"playwright": "^1.65.0",
		"storybook": "^10.6.6",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@11.1.1"
}
